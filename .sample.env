# This file is just a sample, Don't use this file in the project!
# Core
ENV_TYPE={{envType}}
PORT=3742
ENCRYPTION_KEY={{randomString}}
# Generate a unique random value of at least 32 characters for every environment.
JWT_SECRET={{randomString}}
JWT_ISSUER=https://backend-obd.example.com
JWT_AUDIENCE=drive_scope
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=2592000
GEMINI_API_KEY={{geminiApiKey}}
GEMINI_MODEL=gemini-3.5-flash-lite
INSPECTOR_ENABLED=false

# Translation
TRANSLATE_RESPONSE_MESSAGES=1

# Caching
STORE_TYPE=map
STORE_LRU_CAPACITY=1000
REDIS_CONNECTION_STRING={{redisConnectionString}}

# Database
DATABASE_CONNECTION_STRING={{dbConnectionString}}

# Rate Limit
RATE_LIMITER_ENABLED=1
RATE_LIMITER_LIMIT=500
RATE_LIMITER_WINDOW_MS=1000

# Queue
QUEUE_ENABLED=false
